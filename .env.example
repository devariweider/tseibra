# ==========================================================================
# Ambiente de desenvolvimento
# Copie para .env (ajuste a porta se 4000 estiver ocupada) e preencha.
# ==========================================================================

# --- API -------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Origem do front permitida no CORS (somente desenvolvimento)
WEB_ORIGIN=http://localhost:5173

# --- Banco de dados (PostgreSQL) -------------------------------------------
# OBRIGATÓRIO. Sem isso a API não sobe.
# Vercel injeta automaticamente ao criar o Postgres gerenciado:
#   POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING
# Para rodar localmente, use um Postgres (docker, Neon, Supabase…) e cole a
# URL de conexão completa, incluindo ?sslmode=require quando for remoto.
DATABASE_URL=
# Exemplo local:  postgresql://postgres:postgres@localhost:5432/tseibra
# Exemplo remoto: postgresql://user:senha@host/banco?sslmode=require

# --- Sessão ----------------------------------------------------------------
# Segredo de assinatura do JWT.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# OBRIGATÓRIO em produção — a API recusa subir sem ele.
JWT_SECRET=
# Validade da sessão em segundos (padrão 8 h)
JWT_EXPIRES_IN=28800
# Domínio do cookie (necessário se a API rodar em outro subdomínio)
# COOKIE_DOMAIN=.seudominio.com.br

# --- Contas criadas no primeiro boot ---------------------------------------
# Troque estas senhas antes de qualquer uso real.
SEED_ADMIN_EMAIL=admin@tseibra.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_ALUNO_EMAIL=aluno@tseibra.local
SEED_ALUNO_PASSWORD=Aluno@123