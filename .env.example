# Porta da API
PORT=4000
NODE_ENV=development

# Origem do front permitida no CORS (desenvolvimento)
WEB_ORIGIN=http://localhost:5173

# Pasta do banco SQLite
DATA_DIR=server/data

# Segredo de assinatura da sessão — OBRIGATÓRIO em produção
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=28800

# Domínio do cookie (necessário quando a API roda em outro subdomínio)
# COOKIE_DOMAIN=.tseibra.local

# Credenciais criadas no primeiro boot
SEED_ADMIN_EMAIL=admin@tseibra.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_ALUNO_EMAIL=aluno@tseibra.local
SEED_ALUNO_PASSWORD=Aluno@123